# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins. Never use * in production.
CLIENT_URL=http://localhost:5173,http://localhost:5000
# Number of reverse proxies in front of Express (1 for a single nginx/ALB).
TRUST_PROXY=1

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/flareminds_billing

# ---- Auth ----
# Use a random value of at least 32 characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-string
# Keep access tokens short-lived. Existing sessions must log in again after this.
JWT_EXPIRES_IN=12h
# Optional: change only if you also rotate existing tokens.
JWT_ISSUER=flareminds-billing
JWT_AUDIENCE=flareminds-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
# The ADMIN_EMAIL account is always the platform superadmin. Company admins
# are created by the superadmin from Companies and are locked to one tenant.
# Set to true only when you intentionally want a restart to reset the admin password.
ADMIN_SYNC_PASSWORD=false

# ---- Company / invoice details ----
COMPANY_NAME=FlareMinds Technology and Services
COMPANY_GSTN=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_WEBSITE=

# ---- Bank details (printed on the invoice) ----
BANK_ACC_NO=
BANK_NAME=
BANK_IFSC=
BANK_BRANCH=
BANK_UPI=

# ---- Email (Nodemailer) ----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- WhatsApp Cloud API ----
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---- PDF / Chrome ----
CHROME_PATH=

# ---- Bunny.net Storage (company logos) ----
BUNNY_STORAGE_ZONE_NAME=
BUNNY_STORAGE_HOSTNAME=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_CDN_URL=
